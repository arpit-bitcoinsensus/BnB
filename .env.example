# ============================================================
#  Dashboard - Environment Variables Template
#  Copy this file to .env and fill in YOUR values.
#  For Vercel deployments, add these in:
#  Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Your Supabase project URL (found in: Supabase → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase anon/public key (safe to expose — protected by RLS)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Shopify ───────────────────────────────────────────────────
# Your Shopify store domain (e.g. your-brand.myshopify.com)
SHOPIFY_STORE_URL=your-store.myshopify.com

# Your Shopify app's client secret (starts with shpss_ for newer apps)
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret_here

# Required ONLY if using shpss_ secret above.
# Found in: Shopify Partners → Apps → Your App → Client ID
SHOPIFY_CLIENT_ID=your_shopify_client_id_here

# ── AI (Gemini) ───────────────────────────────────────────────
# Your Google AI Studio API key for AI Insights & AI Chat features
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
